<Project Sdk="Microsoft.NET.Sdk">

  <!-- Keel.dll, the starter that Doorstop runs. RefDir is where the game's
       own assemblies are. They aren't in this repository: put them in a
       refs folder beside it, or pass -p:RefDir=... No NuGet packages, so a
       build needs no network. -->

  <PropertyGroup>
    <!-- The game's assemblies are built against netstandard 2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Keel</AssemblyName>
    <RootNamespace>Keel</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>9.0</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- This runs inside a live game, before the game itself, so a warning
         is treated as a bug. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <!-- No symbol file in a release build: a .pdb path would put the build
         machine's folders into a DLL that gets shared. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The refs folder beside this repository, or beside the mod that
         carries a copy of it in a keel folder. -->
    <RefDir Condition="'$(RefDir)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\refs')">$(MSBuildProjectDirectory)\..\..\refs</RefDir>
    <RefDir Condition="'$(RefDir)' == ''">$(MSBuildProjectDirectory)\..\refs</RefDir>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only Unity's core, for the first scene. Nothing from the game or
         BepInEx, so Keel.dll starts whatever version of either is there. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
