<Project Sdk="Microsoft.NET.Sdk">

  <!-- Keel.dll, the starter that Doorstop runs. It starts BepInEx when it's
       there, finds the newest core and hands over, all by reflection, so it
       needs nothing from the game, Unity or BepInEx, and builds with no
       references at all. No NuGet packages, so a build needs no network. -->

  <PropertyGroup>
    <!-- The game's assemblies are built against netstandard 2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Keel</AssemblyName>
    <RootNamespace>Keel</RootNamespace>
    <!-- The starter's own version. It stays 2.0.0 whatever Keel's version
         is, because the starter never changes. -->
    <Version>2.0.0</Version>
    <LangVersion>9.0</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- This runs inside a live game, before the game itself, so a warning
         is treated as a bug. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <!-- No symbol file in a release build: a .pdb path would put the build
         machine's folders into a DLL that gets shared. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
